---
import type { Resume } from '../data/types';
import { chrome } from '../lib/chrome';
import { langUrl } from '../lib/paths';

interface Props {
  resume: Resume;
}

const { resume } = Astro.props;
const { ui, person } = resume;
const text = chrome[resume.lang];
const home = langUrl(resume.lang);

const navItems = [
  { id: 'about', label: ui.nav.about },
  { id: 'education', label: ui.nav.education },
  { id: 'experience', label: ui.nav.experience },
  { id: 'projects', label: ui.nav.projects },
  { id: 'honours', label: ui.nav.honours },
  { id: 'skills', label: ui.nav.skills },
  { id: 'languages', label: ui.nav.languages },
];
---

<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="brand" href={home} aria-label={`${person.name} — ${text.home}`}>
      <span class="brand-mark" aria-hidden="true">ZY</span>
    </a>

    <nav class="nav" id="site-nav" data-nav aria-label={text.primaryNav}>
      <ul role="list">
        {navItems.map((item) => (
          <li>
            <a href={`#${item.id}`} data-spy>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-tools">
      <div class="music-wrap">
        <button
          class="music"
          type="button"
          data-music
          data-label-play={ui.labels.playMusic}
          data-label-pause={ui.labels.pauseMusic}
          aria-pressed="false"
          aria-label={ui.labels.playMusic}
          title={ui.labels.playMusic}
        >
          <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        </button>
        <span class="music-hint mono" data-music-hint hidden>{ui.labels.soundHint}</span>
      </div>

      <div class="lang-toggle" role="group" aria-label={ui.labels.switchLanguage}>
        <a href={langUrl('en')} hreflang="en" lang="en" data-set-lang="en" aria-current={resume.lang === 'en' ? 'true' : undefined}>EN</a>
        <a href={langUrl('zh')} hreflang="zh-CN" lang="zh-CN" data-set-lang="zh" aria-current={resume.lang === 'zh' ? 'true' : undefined}>中文</a>
      </div>

      <button
        class="nav-toggle"
        type="button"
        data-nav-toggle
        data-label-open={ui.labels.menu}
        data-label-close={ui.labels.close}
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label={ui.labels.menu}
      >
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
        <span data-nav-label>{ui.labels.menu}</span>
      </button>
    </div>
  </div>
</header>
